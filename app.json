{
  "expo": {
    "name": "Между нами",
    "slug": "between-us-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "betweenus",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Разрешите приложению использовать Face ID для защиты пространства пары."
        }
      ],
      "expo-font",
      "expo-status-bar"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.betweenus.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.betweenus.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E8EFEE"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4e2b6915-5b8f-4aea-9f71-e69179ece785"
      }
    },
    "owner": "csniacllyou",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4e2b6915-5b8f-4aea-9f71-e69179ece785",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    }
  }
}

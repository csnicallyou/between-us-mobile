{
  "expo": {
    "name": "Между нами",
    "slug": "between-us-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "betweenus",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Разрешите приложению использовать Face ID для защиты пространства пары."
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.betweenus.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.betweenus.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E8EFEE"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}

{
  "name": "between-us-mobile",
  "version": "0.3.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev:iphone": "expo start --dev-client --lan",
    "dev:iphone:tunnel": "expo start --dev-client --tunnel",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "remote:proxy": "node scripts/remote-expo-proxy.mjs",
    "export:web": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "check:source": "node scripts/check-source.mjs",
    "doctor": "npx expo-doctor",
    "verify": "npm run typecheck && npm run check:source && npm run doctor"
  },
  "dependencies": {
    "@expo/ui": "~56.0.25",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "^56.0.19",
    "expo-blur": "~56.0.4",
    "expo-constants": "~56.0.23",
    "expo-dev-client": "~56.0.24",
    "expo-file-system": "~56.0.9",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-image-manipulator": "~56.0.24",
    "expo-image-picker": "~56.0.23",
    "expo-linking": "~56.0.16",
    "expo-notifications": "^56.0.23",
    "expo-router": "~56.2.18",
    "expo-secure-store": "~56.0.4",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.24",
    "expo-widgets": "^56.0.26",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-image-colors": "^2.4.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.14",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "file-type": "22.0.1",
    "phin": "3.7.1"
  }
}
